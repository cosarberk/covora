{
  "name": "@covora/client",
  "version": "0.0.0",
  "private": true,
  "description": "Covora client SDK: ekran/kod yakalayıp review sunucusuna gönderir",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b && pnpm run build:browser",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=Covora --platform=browser --outfile=dist/covora-client.global.js --minify",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@covora/types": "workspace:*",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
