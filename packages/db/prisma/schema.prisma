// Covora veri modeli. Kurallar, projeler, review kayıtları ve coverage
// geçmişi burada tutulur. Migration'lar `pnpm --filter @covora/db db:migrate`
// ile üretilir (DATABASE_URL gerektirir).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewKind {
  ui
  code
}

enum RuleEvaluation {
  deterministic
  llm
}

enum Severity {
  blocker
  warning
  info
}

enum ChecklistOutcome {
  pass
  partial
  fail
}

enum RunStatus {
  queued
  running
  succeeded
  degraded
  failed
  cancelled
}

enum StepStatus {
  pending
  running
  succeeded
  skipped
  failed
  cancelled
}

enum LogLevel {
  debug
  info
  warn
  error
}

enum ProviderType {
  ollama
  openai_compatible
}

/// Review edilen bir birim (plugin / repo).
model Project {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  /// Makine istemcilerinin (pipeline CLI / SDK) review göndermek için kullandığı gizli token.
  ingestToken String         @unique @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  packs       ProjectPack[]
  reviews     Review[]
  runs        ReviewRun[]
  config      ProjectConfig?
  webhooks    Webhook[]
}

/// Bir projeye ait bildirim webhook'u. Seçilen olaylarda hedef URL'ye POST atılır.
model Webhook {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Studio kullanıcısı. Kimlik doğrulama (JWT) için.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Review Pack: bir kural koleksiyonu (tür: ui/code). Projeler pack'lere abone olur.
model Pack {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String        @default("")
  kind        ReviewKind
  builtin     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rules       Rule[]
  projects    ProjectPack[]
}

/// Proje ↔ Pack aboneliği (çoktan-çoğa).
model ProjectPack {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packId    String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([projectId, packId])
}

/// Tek bir review kuralı. Bir pack'e aittir.
model Rule {
  id          String         @id @default(cuid())
  packId      String
  pack        Pack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String         @default("")
  kind        ReviewKind
  evaluation  RuleEvaluation
  severity    Severity
  weight      Float
  prompt      String?
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  audits      RuleAudit[]

  @@unique([packId, key])
  @@index([kind, enabled])
}

/// Kural değişikliklerinin izlenebilirlik kaydı (kim/ne zaman/ne değişti).
model RuleAudit {
  id        String   @id @default(cuid())
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  action    String
  changedBy String
  changes   Json
  createdAt DateTime @default(now())

  @@index([ruleId, createdAt])
}

/// Bir review çalıştırmasının kaydı.
model Review {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       ReviewKind
  codeHash   String
  score      Float
  level      String
  gatePassed Boolean
  /// Bir önceki aynı tür review'a göre skor farkı (ilk review'da null).
  delta      Float?
  createdAt  DateTime       @default(now())
  results    ReviewResult[]
  run        ReviewRun?

  @@index([projectId, createdAt])
}

/// Bir review'ın yürütme (pipeline) kaydı. Kuyruğa alınır, adımlardan geçer,
/// loglanır; başarıyla bittiğinde bir Review üretip ona bağlanır.
model ReviewRun {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       ReviewKind
  codeHash   String
  status     RunStatus  @default(queued)
  /// Review girdisi (ekran görüntüsü/dosyalar) — worker işleyene dek saklanır, sonra temizlenebilir.
  input      Json
  /// Başarıyla üretilen sonuç kaydı (tamamlanınca bağlanır).
  reviewId   String?    @unique
  review     Review?    @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  /// Önceki aynı tür review'a göre skor farkı (ilk review'da null).
  delta      Float?
  /// Run `failed` olduğunda kök hata özeti.
  error      String?
  /// Tekrar denenme sayısı.
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  steps      RunStep[]
  logs       RunLog[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

/// Bir run içindeki tek bir adım (job/stage).
model RunStep {
  id         String     @id @default(cuid())
  runId      String
  run        ReviewRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  key        String
  name       String
  order      Int
  status     StepStatus @default(pending)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  @@unique([runId, key])
  @@index([runId, order])
}

/// Bir run'a (ve opsiyonel bir adıma) ait tek bir log satırı. Canlı akar,
/// kalıcı saklanır.
model RunLog {
  id      String    @id @default(cuid())
  runId   String
  run     ReviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq     Int
  at      DateTime  @default(now())
  level   LogLevel  @default(info)
  stepKey String?
  message String

  @@unique([runId, seq])
  @@index([runId, seq])
}

/// Bir review içindeki tek bir kural sonucu.
model ReviewResult {
  id       String           @id @default(cuid())
  reviewId String
  review   Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  ruleKey  String
  outcome  ChecklistOutcome
  note     String?

  @@index([reviewId])
}

/// Studio'dan yönetilen LLM sağlayıcısı. Her review türü için bir tanesi aktif.
model ProviderConfig {
  id            String       @id @default(cuid())
  name          String
  providerType  ProviderType @default(ollama)
  kind          ReviewKind
  baseUrl       String
  model         String
  /// Yetenekler: görsel (UI) ve/veya metin (code) girdisi işleyebilir mi.
  visionCapable Boolean      @default(false)
  textCapable   Boolean      @default(false)
  /// OpenAI-uyumlu uç noktalar için gizli API anahtarı (asla UI'ya dönülmez).
  apiKey        String?
  active        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([kind, active])
}

/// Proje bazlı coverage yapılandırması ve gate politikası.
model ProjectConfig {
  id                        String  @id @default(cuid())
  projectId                 String  @unique
  project                   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partialCredit             Float   @default(0.5)
  levels                    Json
  gateMinScore              Float   @default(60)
  gateBlockOnFailedBlockers Boolean @default(true)
  gateBlockOnRegression     Boolean @default(false)
  regressionThreshold       Float   @default(5)
}
