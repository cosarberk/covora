// Covora veri modeli. Kurallar, projeler, review kayıtları ve coverage
// geçmişi burada tutulur. Migration'lar `pnpm --filter @covora/db db:migrate`
// ile üretilir (DATABASE_URL gerektirir).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewKind {
  ui
  code
}

enum RuleEvaluation {
  deterministic
  llm
}

enum Severity {
  blocker
  warning
  info
}

enum ChecklistOutcome {
  pass
  partial
  fail
}

/// Review edilen bir birim (plugin / repo).
model Project {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  /// Makine istemcilerinin (pipeline CLI / SDK) review göndermek için kullandığı gizli token.
  ingestToken String         @unique @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  packs       ProjectPack[]
  reviews     Review[]
  config      ProjectConfig?
}

/// Studio kullanıcısı. Kimlik doğrulama (JWT) için.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Review Pack: bir kural koleksiyonu (tür: ui/code). Projeler pack'lere abone olur.
model Pack {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String        @default("")
  kind        ReviewKind
  builtin     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rules       Rule[]
  projects    ProjectPack[]
}

/// Proje ↔ Pack aboneliği (çoktan-çoğa).
model ProjectPack {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packId    String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([projectId, packId])
}

/// Tek bir review kuralı. Bir pack'e aittir.
model Rule {
  id          String         @id @default(cuid())
  packId      String
  pack        Pack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String         @default("")
  kind        ReviewKind
  evaluation  RuleEvaluation
  severity    Severity
  weight      Float
  prompt      String?
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  audits      RuleAudit[]

  @@unique([packId, key])
  @@index([kind, enabled])
}

/// Kural değişikliklerinin izlenebilirlik kaydı (kim/ne zaman/ne değişti).
model RuleAudit {
  id        String   @id @default(cuid())
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  action    String
  changedBy String
  changes   Json
  createdAt DateTime @default(now())

  @@index([ruleId, createdAt])
}

/// Bir review çalıştırmasının kaydı.
model Review {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       ReviewKind
  codeHash   String
  score      Float
  level      String
  gatePassed Boolean
  createdAt  DateTime       @default(now())
  results    ReviewResult[]

  @@index([projectId, createdAt])
}

/// Bir review içindeki tek bir kural sonucu.
model ReviewResult {
  id       String           @id @default(cuid())
  reviewId String
  review   Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  ruleKey  String
  outcome  ChecklistOutcome
  note     String?

  @@index([reviewId])
}

/// Studio'dan yönetilen LLM sağlayıcısı. Her review türü için bir tanesi aktif.
model ProviderConfig {
  id        String     @id @default(cuid())
  name      String
  kind      ReviewKind
  baseUrl   String
  model     String
  active    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([kind, active])
}

/// Proje bazlı coverage yapılandırması ve gate politikası.
model ProjectConfig {
  id                        String  @id @default(cuid())
  projectId                 String  @unique
  project                   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partialCredit             Float   @default(0.5)
  levels                    Json
  gateMinScore              Float   @default(60)
  gateBlockOnFailedBlockers Boolean @default(true)
}
