# Covora server ortam değişkenleri
PORT=4000

# Postgres
DATABASE_URL=postgresql://covora:covora@localhost:5432/covora

# UI (vision) review — Ollama
OLLAMA_UI_BASE_URL=http://localhost:11434
OLLAMA_UI_MODEL=qwen3-vl:8b

# Code review — Ollama
OLLAMA_CODE_BASE_URL=http://localhost:11434
OLLAMA_CODE_MODEL=qwen3-coder:7b

# Kimlik doğrulama (JWT). Secret en az 16 karakter olmalı.
COVORA_AUTH_SECRET=degistir-bu-gizli-anahtari-lutfen
# İlk kurulumda admin seed'i (hiç kullanıcı yoksa oluşturulur)
COVORA_ADMIN_EMAIL=admin@covora.local
COVORA_ADMIN_PASSWORD=covora-admin
