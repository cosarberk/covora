{
  "name": "@covora/server",
  "version": "0.0.0",
  "private": true,
  "description": "Covora review sunucusu (motor + REST API)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@covora/checkers": "workspace:*",
    "@covora/core": "workspace:*",
    "@covora/db": "workspace:*",
    "@covora/provider-ollama": "workspace:*",
    "@covora/types": "workspace:*",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
