# ============================================================================
#  Covora — paket registry ayarı
#
#  DİKKAT: Bu makinedeki npm hesabı yayın için KULLANILMAMALIDIR.
#  Paketler yayına hazır olana kadar hepsi package.json'da "private": true
#  olarak işaretlidir. Kendi registry'nizi kurup adresini aşağıya yazın ve
#  ilgili paketlerin "private" bayrağını KENDİNİZ kaldırın.
#
#  registry=https://<kendi-registry-adresiniz>/
#  @covora:registry=https://<kendi-registry-adresiniz>/
# ============================================================================

auto-install-peers=true
